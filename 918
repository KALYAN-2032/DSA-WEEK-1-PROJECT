class Solution {
    public int maxSubarraySumCircular(int[] nums) {
        int totalSum = 0;
        int currMax = 0, maxSum = nums[0];
        int currMin = 0, minSum = nums[0];
        
        for (int num : nums) {
            totalSum += num;
            
            // Kadane's for Maximum Subarray Sum
            currMax = Math.max(currMax + num, num);
            maxSum = Math.max(maxSum, currMax);
            
            // Kadane's for Minimum Subarray Sum
            currMin = Math.min(currMin + num, num);
            minSum = Math.min(minSum, currMin);
        }
        
        // If all numbers are negative, maxSum will be the largest negative number
        if (maxSum < 0) {
            return maxSum;
        }
        
        // Return the maximum of non-circular (maxSum) and circular (totalSum - minSum)
        return Math.max(maxSum, totalSum - minSum);
    }
}
