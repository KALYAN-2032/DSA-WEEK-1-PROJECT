import java.util.HashMap;
import java.util.Map;

class Solution {
    public long countBadPairs(int[] nums) {
        int n = nums.length;
        long totalPairs = (long) n * (n - 1) / 2;
        long goodPairs = 0;
        
        Map<Integer, Long> freqMap = new HashMap<>();
        
        for (int i = 0; i < n; i++) {
            int key = nums[i] - i;
            // If this key has appeared before, all previous occurrences form a good pair with current index
            goodPairs += freqMap.getOrDefault(key, 0L);
            freqMap.put(key, freqMap.getOrDefault(key, 0L) + 1);
        }
        
        return totalPairs - goodPairs;
    }
}
